from collections.abc import Iterable

class BoolRef:
    def __eq__(self, other: object) -> BoolRef: ...
    def __ne__(self, other: object) -> BoolRef: ...

class ArithRef:
    def __add__(self, other: ArithRef | int) -> ArithRef: ...
    def __radd__(self, other: int) -> ArithRef: ...
    def __sub__(self, other: ArithRef | int) -> ArithRef: ...
    def __rsub__(self, other: int) -> ArithRef: ...
    def __mul__(self, other: ArithRef | int) -> ArithRef: ...
    def __eq__(self, other: object) -> BoolRef: ...
    def __ne__(self, other: object) -> BoolRef: ...
    def __lt__(self, other: ArithRef | int) -> BoolRef: ...
    def __le__(self, other: ArithRef | int) -> BoolRef: ...
    def __gt__(self, other: ArithRef | int) -> BoolRef: ...
    def __ge__(self, other: ArithRef | int) -> BoolRef: ...
    def as_long(self) -> int: ...

class CheckSatResult:
    def __eq__(self, other: object) -> bool: ...

class ModelRef:
    def eval(self, expr: ArithRef, model_completion: bool = False) -> ArithRef: ...

class Solver:
    def set(self, *, timeout: int) -> None: ...
    def add(self, *args: BoolRef | bool) -> None: ...
    def assert_and_track(self, expr: BoolRef, label: str) -> None: ...
    def check(self) -> CheckSatResult: ...
    def model(self) -> ModelRef: ...
    def unsat_core(self) -> list[BoolRef]: ...
    def reason_unknown(self) -> str: ...

def Int(name: str) -> ArithRef: ...
def IntVal(value: int) -> ArithRef: ...
def BoolVal(value: bool) -> BoolRef: ...
def And(*args: BoolRef | bool) -> BoolRef: ...
def Or(*args: BoolRef | bool) -> BoolRef: ...
def Not(arg: BoolRef | bool) -> BoolRef: ...
def Distinct(*args: ArithRef) -> BoolRef: ...
def If(condition: BoolRef | bool, yes: ArithRef | int, no: ArithRef | int) -> ArithRef: ...
def Sum(args: Iterable[ArithRef]) -> ArithRef: ...

sat: CheckSatResult
unsat: CheckSatResult
unknown: CheckSatResult

def is_true(value: BoolRef) -> bool: ...
def is_false(value: BoolRef) -> bool: ...
